{
  "name": "biohubbc",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "eslint": "^9.34.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0"
  },
  "scripts": {
    "lint-fix": "npx eslint --fix",
    "format-fix": "prettier --log-level=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\""
  },
  "lint-staged": {
    "app/**/*.{js,ts,tsx}": [
      "npm run lint-fix --prefix app",
      "npm run format-fix --prefix app"
    ],
    "api/**/*.{js,ts,tsx}": [
      "npm run lint-fix --prefix api",
      "npm run format-fix --prefix api"
    ],
    "database/**/*.{js,ts,tsx}": [
      "npm run lint-fix --prefix database",
      "npm run format-fix --prefix database"
    ]
  }
}