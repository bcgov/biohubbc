{
  "name": "biohubbc",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "eslint": "^9.34.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0"
  },
  "scripts": {
    "lint-fix": "npx eslint --fix",
    "format-fix": "npx prettier --write",
    "test:api": "npx --prefix api npm test",
    "test:app": "npx --prefix app npm test",
    "test:all": "npm run test:api && npm run test:app"
  },
  "lint-staged": {
    "app/**/*.{js,ts,tsx}": [
      "npx eslint --fix --config ./app/eslint.config.mjs",
      "npx prettier --write app"
    ],
    "api/**/*.{js,ts,tsx}": [
      "npx eslint --fix --config ./api/eslint.config.mjs",
      "npx prettier --write api"
    ],
    "database/**/*.{js,ts,tsx}": [
      "npx eslint --fix --config ./database/eslint.config.mjs",
      "npx prettier --write database"
    ]
  }
}