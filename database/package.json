{
  "name": "sims-db",
  "version": "0.0.0",
  "description": "Database migrations/seeding for SIMS",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcgov/biohubbc.git"
  },
  "engines": {
    "node": ">= 20.0.0",
    "npm": ">= 10.0.0"
  },
  "scripts": {
    "setup": "npm-run-all -l -s migrate-latest seed",
    "migrate-latest": "knex migrate:latest --knexfile ./src/knexfile.ts",
    "migrate-rollback": "knex migrate:rollback --knexfile ./src/knexfile.ts",
    "seed": "knex seed:run --knexfile ./src/knexfile.ts",
    "lint": "eslint .",
    "lint-fix": "npm run lint -- --fix",
    "format": "prettier --log-level=warn --check \"./src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "format-fix": "prettier --log-level=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "fix": "npm-run-all -l -s lint-fix format-fix"
  },
  "dependencies": {
    "@swc/core": "^1.11.13",
    "knex": "^2.4.2",
    "pg": "^8.14.1",
    "typescript": "^4.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@faker-js/faker": "^9.6.0",
    "@types/node": "^20.17.16",
    "@types/pg": "^8.11.11",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.28.0"
  }
}
